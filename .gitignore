bin/*
lib/*
build/
# docs/build/ is the knowledge bundle's build folder (documentation), not a tree.
!docs/build/
# Scratch tree for containerized test builds. Only ever build ONE tree at a
# time: CMAKE_*_OUTPUT_DIRECTORY point at the shared source-tree bin/ and
# lib/, so two trees overwrite each other's binaries while each still
# considers its own targets up to date.
build-tests/
# Scratch tree for the zig cc toolchain build (cmake/zig-toolchain.cmake).
# Same one-tree-at-a-time caveat as build-tests/ above: it shares bin/ and
# lib/ with build/, so a zig build overwrites the gcc binaries in place.
build-zig/
*.o
*.a
.deps

# IDE & Editor
.vscode/
.idea/
# Local Claude Code state stays out of the repo; .claude/skills/ is checked
# in, because a skill is a shared checklist like the scripts under tests/.
.claude/*
!.claude/skills/
*.swp
*.swo
*~
.DS_Store
.clang-format-backup

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.bak

# Compiled files
*.so
*.dylib
*.exe
src/server/websocketproxyserver/target/
src/server/websocketproxyserver/config.json
