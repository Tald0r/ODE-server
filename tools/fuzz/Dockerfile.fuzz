# The libFuzzer toolchain for the packet-read fuzzers (tests/fuzz/).
#
# The development image (Dockerfile.dev) builds with zig c++, which ships
# neither libFuzzer nor the sanitizer runtimes, so the fuzzers build here
# with the distribution's Clang 18 and its compiler-rt. The server's
# libraries are installed only because the top-level CMakeLists.txt always
# configures src/server; the fuzz targets link none of them.
#
#   docker build -f tools/fuzz/Dockerfile.fuzz -t darkeden-fuzz tools/fuzz
FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        clang-18 libclang-rt-18-dev llvm-18 cmake ninja-build perl \
        libmysqlclient-dev liblua5.1-0-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
